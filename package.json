{
  "name": "laravel-ide-helper",
  "displayName": "Laravel Ide Helper",
  "description": "Plugin to run Laravel Ide helper commands for better code suggestion",
  "version": "1.1.0",
  "publisher": "georgykurian",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "assets/images/icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/georgyKurian/vscode-laravel-ide-helper"
  },
  "bugs": {
    "url": "https://github.com/georgyKurian/vscode-laravel-ide-helper/issues"
  },
  "homepage": "https://github.com/georgyKurian/vscode-laravel-ide-helper/blob/main/README.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "Laravel",
    "Artisan",
    "intellisense",
    "php",
    "ide"
  ],
  "galleryBanner": {
    "color": "#EFF1F3",
    "theme": "light"
  },
  "activationEvents": [
    "workspaceContains:**/artisan",
    "onLanguage:php"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "laravelIdeHelper.laravelGenerateAll",
        "title": "Laravel Helper: Run All Helpers"
      },
      {
        "command": "laravelIdeHelper.laravelFacadeGenerate",
        "title": "Laravel Helper: Run Facade Helper"
      },
      {
        "command": "laravelIdeHelper.laravelModelGenerate",
        "title": "Laravel Helper: Run Model Helper"
      },
      {
        "command": "laravelIdeHelper.laravelMetaGenerate",
        "title": "Laravel Helper: Run Meta Helper"
      },
      {
        "command": "laravelIdeHelper.clearCaches",
        "title": "Laravel Helper: Clear Caches"
      }
    ],
    "configuration": {
      "title": "Laravel Helper",
      "properties": {
        "helper.facades": {
          "type": "boolean",
          "default": true,
          "description": "Generates PHPDoc for Laravel Facades"
        },
        "helper.models": {
          "type": "boolean",
          "default": true,
          "description": "Generates PHPDoc for Models"
        },
        "helper.autoClearConsole": {
          "type": "boolean",
          "default": false,
          "description": "Automatically clear the output console before running commands"
        },
        "helper.phpPath": {
          "type": "string",
          "default": "php",
          "description": "Path to PHP executable (e.g., 'php' or '/usr/local/bin/php')"
        },
        "helper.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run IDE helper commands when saving PHP files"
        },
        "helper.debounceDelay": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "maximum": 10000,
          "description": "Delay in milliseconds before running commands after saving (prevents multiple runs on rapid saves)"
        },
        "helper.parallelExecution": {
          "type": "boolean",
          "default": true,
          "description": "Run multiple commands in parallel for faster execution"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js && npm run compile-tests",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "check-types": "tsc --noEmit",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "lint": "eslint src/",
    "pretest": "(cd ./data/test/test-workspace/ && composer install) && npm run compile",
    "test": "node ./out/test/runTest.js",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.2",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
